# Copy this file to .env for local development. Run `netlify link` once first
# to connect this folder to the real Netlify site (needed for Blobs to work
# in `netlify dev` - see README). In production, set these as environment
# variables in the Netlify site's dashboard instead - Site configuration >
# Environment variables. Never commit a real .env file.
#
# NETLIFY_SITE_ID and NETLIFY_BLOBS_TOKEN are NOT needed here - Blobs
# context is auto-injected by `netlify link` / the Functions runtime.
# Don't add them, even blank - an empty value overrides the automatic
# context instead of falling back to it.

# YSuite's middleware base URL. Defaults to https://middleware.ysuites.co if
# unset, but set it explicitly so it's visible rather than implicit.
YSUITE_API_BASE_URL=https://middleware.ysuites.co

# Bearer token sent as Authorization: Bearer <token> on every request to
# YSuite. Static - no rotation/refresh logic exists. Replace manually if it
# expires.
YSUITE_JWT=

# Property ID is NOT set here - it's read from Setup > Property Information
# in the app itself (stored via rates.js), not an environment variable.
