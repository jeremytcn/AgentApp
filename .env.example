# Copy this file to .env for local development (netlify dev picks it up
# automatically). In production, set these as environment variables in the
# Netlify site's dashboard instead - Site configuration > Environment
# variables. Never commit a real .env file.

# YSuite's middleware base URL. Defaults to https://middleware.ysuites.co if
# unset, but set it explicitly so it's visible rather than implicit.
YSUITE_API_BASE_URL=https://middleware.ysuites.co

# Bearer token sent as Authorization: Bearer <token> on every request to
# YSuite. Static - no rotation/refresh logic exists. Replace manually if it
# expires.
YSUITE_JWT=

# This property's RMS property ID, as used elsewhere (e.g. the main Room
# Availability Dashboard's per-property rmsPropertyId).
YSUITE_PROPERTY_ID=
